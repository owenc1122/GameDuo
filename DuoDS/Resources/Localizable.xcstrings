    "默认使用 512×384 内部高清渲染，兼顾稳定帧率与功耗。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses 512×384 internal rendering by default to balance clarity, frame rate, and power use."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认使用 512×384 内部高清渲染，兼顾稳定帧率与功耗。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默認使用 512×384 內部高清渲染，兼顧穩定幀率與功耗。"
          }
        }
      }
    },
    "默认开启。自动尝试提升可变帧率游戏，能稳定接近 60 帧时保留；锁帧、性能不足或发热时恢复原版。不会加速游戏。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enabled by default. Tries a higher rate for variable-frame-rate games and keeps it when performance allows. Falls back for locked games, heavy load, or heat without speeding up gameplay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认开启。自动尝试提升可变帧率游戏，能稳定接近 60 帧时保留；锁帧、性能不足或发热时恢复原版。不会加速游戏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默認開啓。自動嘗試提升可變幀率遊戲，能穩定接近 60 幀時保留；鎖幀、性能不足或發熱時恢復原版。不會加速遊戲。"
          }
        }
      }
    },

 int32 CIopBios::LoadModuleFromAddress(uint32 modulePtr, uint32 loadAddress, bool ownsMemory)
 {
 	CELF32 module(m_ram + modulePtr);
+#ifdef _IOP_EMULATE_MODULES
+	//Game Duo: homebrew loads its own pad drivers (ps2sdk freepad/freesio2, IOP module names
+	//"padman"/"sio2man") from EE memory. Use the HLE pad manager for them, like the BIOS ones.
+	{
+		const auto& header = module.GetHeader();
+		for(unsigned int i = 0; i < header.nSectHeaderCount; i++)
+		{
+			auto sectionHeader = module.GetSection(i);
+			if(sectionHeader->nType != IOPMOD_SECTION_ID) continue;
+			auto iopMod = reinterpret_cast<const IOPMOD*>(module.GetSectionData(i));
+			std::string name = iopMod->moduleName;
+			const char* hlePath = (name == "padman") ? "rom0:XPADMAN" : (name == "sio2man") ? "rom0:XSIO2MAN" : nullptr;
+			if(!hlePath) break;
+			auto hleModuleIterator = m_hleModules.find(hlePath);
+			if(hleModuleIterator != std::end(m_hleModules))
+			{
+				return LoadHleModule(hleModuleIterator->second);
+			}
+			break;
+		}
+	}
+#endif
 	return LoadModule(module, "", loadAddress, ownsMemory);
 }
 

 void CGSH_OpenGLJs::PresentBackbuffer()
 {
+	// Hand the finished frame to the page (whole frames only, no tearing), then apply a pending
+	// resize so the next frame is drawn at the new size.
+	EM_ASM({
+		var canvas = GL.offscreenCanvases['duoGS'].canvas;
+		var frame = canvas.transferToImageBitmap();
+		var message = {};
+		message.duoFrame = frame;
+		postMessage(message, [frame]);
+		if(canvas.width != $0 || canvas.height != $1)
+		{
+			canvas.width = $0;
+			canvas.height = $1;
+		}
+	}, m_outputWidth.load(), m_outputHeight.load());
 }

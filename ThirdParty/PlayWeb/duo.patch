+bool CDirectoryRecord::ReadNext(Framework::CStream* stream, uint64& directorySize, CDirectoryRecord& record)
+{
+	static const uint64 sectorSize = 0x800;
+	//Directories are at most a few hundred sectors; this also bounds a corrupt size.
+	static const uint64 maxDirectorySize = 0x100000;
+	while(1)
+	{
+		uint64 position = stream->Tell();
+		uint64 limit = (directorySize != 0) ? directorySize : sectorSize;
+		if(position >= std::min(limit, maxDirectorySize)) return false;
+		uint8 length = stream->Read8();
+		if(stream->IsEOF()) return false;
+		if(length == 0)
+		{
+			if(directorySize == 0) return false;
+			stream->Seek(((position / sectorSize) + 1) * sectorSize, Framework::STREAM_SEEK_SET);
+			continue;
+		}
+		stream->Seek(position, Framework::STREAM_SEEK_SET);
+		record = CDirectoryRecord(stream);
+		if(directorySize == 0 && record.GetName()[0] == 0x00)
+		{
+			directorySize = record.GetDataLength();
+		}
+		return true;
+	}
+}
+
+bool CDirectoryRecord::NameMatches(const char* recordName, const char* name)
+{
+	auto baseLength = [](const char* text) {
+		const char* separator = strchr(text, ';');
+		return separator ? static_cast<size_t>(separator - text) : strlen(text);
+	};
+	size_t recordLength = baseLength(recordName);
+	size_t nameLength = baseLength(name);
+	if(recordLength != nameLength) return false;
+	for(size_t i = 0; i < nameLength; i++)
+	{
+		if(tolower(static_cast<unsigned char>(recordName[i])) != tolower(static_cast<unsigned char>(name[i]))) return false;
+	}
+	return true;
+}
+
 uint8 CDirectoryRecord::GetLength() const
 {
 	return m_length;

+#include "InputProviderDuo.h"
+#include <emscripten.h>
+
+constexpr uint32 PROVIDER_ID = 'Duo!';
+
+uint32 CInputProviderDuo::GetId() const
+{
+	return PROVIDER_ID;
+}
+
+std::string CInputProviderDuo::GetTargetDescription(const BINDINGTARGET&) const
+{
+	return std::string();
+}
+
+BINDINGTARGET CInputProviderDuo::MakeButtonTarget(PS2::CControllerInfo::BUTTON button)
+{
+	auto type = PS2::CControllerInfo::IsAxis(button) ? BINDINGTARGET::KEYTYPE::AXIS : BINDINGTARGET::KEYTYPE::BUTTON;
+	return BINDINGTARGET(PROVIDER_ID, DeviceIdType{{0}}, button, type);
+}
+
+BINDINGTARGET CInputProviderDuo::MakeMotorTarget()
+{
+	return BINDINGTARGET(PROVIDER_ID, DeviceIdType{{0}}, 0, BINDINGTARGET::KEYTYPE::MOTOR);
+}
+
+void CInputProviderDuo::SetPadState(uint32 buttons, uint8 lx, uint8 ly, uint8 rx, uint8 ry)
+{
+	using namespace PS2;
+	const uint8 axes[4] = {lx, ly, rx, ry};
+	for(uint32 i = 0; i < 4; i++)
+	{
+		if(m_axesSent && axes[i] == m_axes[i]) continue;
+		m_axes[i] = axes[i];
+		OnInput(MakeButtonTarget(static_cast<CControllerInfo::BUTTON>(CControllerInfo::ANALOG_LEFT_X + i)), axes[i]);
+	}
+	m_axesSent = true;
+	uint32 changed = buttons ^ m_buttons;
+	m_buttons = buttons;
+	for(uint32 i = CControllerInfo::DPAD_UP; i < CControllerInfo::MAX_BUTTONS; i++)
+	{
+		if(!(changed & (1 << i))) continue;
+		OnInput(MakeButtonTarget(static_cast<CControllerInfo::BUTTON>(i)), (buttons >> i) & 1);
+	}
+}
+
+void CInputProviderDuo::SetVibration(DeviceIdType, uint8 largeMotor, uint8 smallMotor)
+{
+	if(largeMotor == m_largeMotor && smallMotor == m_smallMotor) return;
+	m_largeMotor = largeMotor;
+	m_smallMotor = smallMotor;
+	MAIN_THREAD_ASYNC_EM_ASM({
+		if(Module.duoOnVibration) Module.duoOnVibration($0, $1);
+	}, largeMotor, smallMotor);
+}

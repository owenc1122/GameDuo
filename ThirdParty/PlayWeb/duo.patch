+//infoMode: 1 = current mode id, 2 = current extended id, 3 = current offset, 4 = mode table.
+void CPadMan::InfoMode(uint32* args, uint32 argsSize, uint32* ret, uint32 retSize, uint8* ram)
+{
+	uint32 port = args[1];
+	uint32 infoMode = args[3];
+	int32 index = static_cast<int32>(args[4]);
+	bool dualShock = (port < MAX_PADS) ? m_dualShockMode[port] : true;
+	static const uint32 modeTable[2] = {PAD_MODE_DIGITAL, PAD_MODE_DUALSHOCK};
+	uint32 result = 0;
+	switch(infoMode)
+	{
+	case 1:
+		result = dualShock ? PAD_MODE_DUALSHOCK : PAD_MODE_DIGITAL;
+		break;
+	case 2:
+		result = dualShock ? PAD_MODE_DUALSHOCK : PAD_MODE_DIGITAL;
+		break;
+	case 3:
+		result = dualShock ? 1 : 0;
+		break;
+	case 4:
+		if(index == -1)
+			result = 2;
+		else if(index >= 0 && index < 2)
+			result = modeTable[index];
+		break;
+	}
+	ret[5] = result;
+}
+
+//Two actuators like a DualShock 2: 0 = small (on/off), 1 = large (0-255).
+void CPadMan::InfoAct(uint32* args, uint32 argsSize, uint32* ret, uint32 retSize, uint8* ram)
+{
+	int32 actuator = static_cast<int32>(args[3]);
+	uint32 command = args[4];
+	static const uint8 actData[2][4] = {{0x00, 0x00, 0x01, 0x01}, {0x00, 0x01, 0x01, 0x01}};
+	if(actuator == -1)
+		ret[5] = 2;
+	else if(actuator >= 0 && actuator < 2 && command < 4)
+		ret[5] = actData[actuator][command];
+	else
+		ret[5] = 0;
+}
+
+void CPadMan::SetActDirect(uint32* args, uint32 argsSize, uint32* ret, uint32 retSize, uint8* ram)
+{
+	uint32 port = args[1];
+	auto act = reinterpret_cast<const uint8*>(args + 3);
+	if(port < MAX_PADS)
+	{
+		m_smallMotor[port] = act[0] ? 0xFF : 0;
+		m_largeMotor[port] = act[1];
+	}
+	ret[5] = 1;
+}
+
+void CPadMan::GetVibration(unsigned int padId, uint8& largeMotor, uint8& smallMotor)
+{
+	if(padId >= MAX_PADS) return;
+	largeMotor = m_largeMotor[padId];
+	smallMotor = m_smallMotor[padId];
 }
 

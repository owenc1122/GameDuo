+//Game Duo: when the GS cannot keep up with 60 frames per second, draw only every other frame
+//so the emulation, and with it the sound, stays at full speed. Slow frames are caught within
+//about 8 frames (a leaky count of frame intervals above 17.2 ms), before the audio buffer runs
+//dry. Drawing every frame is retried after a back-off (3 s, doubling up to 30 s on each failed
+//try), and only when the drawn frames took under 13.5 ms of GS time, so scenes right at the
+//limit never retry (each failed retry was an audible hitch); it counts as recovered after 5 s
+//at full speed. Only drawing is skipped: vertex queues, transfers and
+//registers are processed as usual.
+void CGSH_OpenGL::UpdateFrameSkip()
+{
+	auto now = std::chrono::steady_clock::now();
+	double interval = 16.7;
+	if(m_frameSkipLastFlip != std::chrono::steady_clock::time_point())
+	{
+		interval = std::chrono::duration<double, std::milli>(now - m_frameSkipLastFlip).count();
+	}
+	m_frameSkipLastFlip = now;
+	m_frameSkipInterval += (std::min(interval, 100.0) - m_frameSkipInterval) * 0.1;
+	//GS thread time of the frame that just ended; while skipping, the drawn frames tell whether
+	//drawing every frame would fit in 16.7 ms.
+	if(m_frameSkipActive && !m_frameSkipDraw)
+	{
+		m_frameSkipDrawnBusy += (std::min(m_threadBusyTime, 100.0) - m_frameSkipDrawnBusy) * 0.1;
+	}
+	m_threadBusyTime = 0;
+
+	if(!m_frameSkipActive)
+	{
+		if(interval > 17.2)
+			m_frameSkipSlowFrames += 1;
+		else if(m_frameSkipSlowFrames > 0)
+			m_frameSkipSlowFrames -= 1;
+		if(m_frameSkipSlowFrames >= 8)
+		{
+			if(m_frameSkipProbing) m_frameSkipBackoff = std::min(m_frameSkipBackoff * 2, 1800U);
+			m_frameSkipActive = true;
+			m_frameSkipProbing = false;
+			m_frameSkipStateFrames = 0;
+			printf("DUO_FRAMESKIP on (interval %.1f ms, retry in %u frames)\n", m_frameSkipInterval, m_frameSkipBackoff);
+		}
+		else if(m_frameSkipProbing && (++m_frameSkipStateFrames >= 300))
+		{
+			m_frameSkipProbing = false;
+			m_frameSkipBackoff = 180;
+			printf("DUO_FRAMESKIP off\n");
+		}
+	}
+	else if((++m_frameSkipStateFrames >= m_frameSkipBackoff) && (m_frameSkipDrawnBusy < 13.5))
+	{
+		m_frameSkipActive = false;
+		m_frameSkipProbing = true;
+		m_frameSkipStateFrames = 0;
+		m_frameSkipSlowFrames = 0;
+	}
+	m_frameSkipDraw = m_frameSkipActive && !m_frameSkipDraw;
+}

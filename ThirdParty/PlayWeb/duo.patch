index 0000000..fc9b0ae
--- /dev/null
+++ b/Source/ui_js/SH_Duo.cpp
@@ -0,0 +1,52 @@
+#include "SH_Duo.h"
+#include <algorithm>
+#include <vector>
+
+static CSH_Duo::RING g_ring = {{0}, {0}, CSH_Duo::RING_FRAMES, 48000, {}};
+
+CSoundHandler::FactoryFunction CSH_Duo::GetFactoryFunction()
+{
+	return []() { return new CSH_Duo(); };
+}
+
+CSH_Duo::RING* CSH_Duo::GetRing()
+{
+	return &g_ring;
+}
+
+void CSH_Duo::Reset()
+{
+	g_ring.writeFrames.store(g_ring.readFrames.load());
+}
+
+void CSH_Duo::Write(int16* samples, unsigned int sampleCount, unsigned int sampleRate)
+{
+	std::vector<float> converted(samples, samples + sampleCount);
+	WriteFloat(converted.data(), sampleCount, sampleRate);
+}
+
+void CSH_Duo::WriteFloat(const float* samples, unsigned int sampleCount, unsigned int sampleRate)
+{
+	g_ring.sampleRate = sampleRate;
+	uint32 frames = sampleCount / 2;
+	uint32 write = g_ring.writeFrames.load(std::memory_order_relaxed);
+	uint32 read = g_ring.readFrames.load(std::memory_order_acquire);
+	uint32 free = RING_FRAMES - (write - read);
+	// When the reader has stalled (page hidden, audio suspended) drop this block instead of
+	// overwriting what it has not read yet.
+	if(frames > free) return;
+	uint32 pos = write % RING_FRAMES;
+	uint32 first = std::min(frames, RING_FRAMES - pos);
+	std::copy(samples, samples + first * 2, g_ring.samples + pos * 2);
+	std::copy(samples + first * 2, samples + frames * 2, g_ring.samples);
+	g_ring.writeFrames.store(write + frames, std::memory_order_release);
+}
+
+bool CSH_Duo::HasFreeBuffers()
+{
+	return true;
+}
+
+void CSH_Duo::RecycleBuffers()
+{
+}
diff --git a/Source/ui_js/SH_Duo.h b/Source/ui_js/SH_Duo.h
new file mode 100644
index 0000000..ded9b53
--- /dev/null
+++ b/Source/ui_js/SH_Duo.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include "sound/SoundHandler.h"
+#include <atomic>
+
+// Game Duo sound output: the SPU mix goes into a lock-free ring buffer in wasm memory that an
+// AudioWorklet (duo_audio.js in the app) reads on the audio thread, so audio never waits for the
+// browser main thread (which is busy proxying WebGL calls).
+class CSH_Duo : public CSoundHandler
+{
+public:
+	enum
+	{
+		RING_FRAMES = 32768, // stereo frames, ~0.68 s at 48 kHz
+	};
+
+	struct RING
+	{
+		std::atomic<uint32> writeFrames; // total frames written (wraps)
+		std::atomic<uint32> readFrames;  // total frames read by the worklet (wraps)
+		uint32 capacity;
+		uint32 sampleRate;
+		float samples[RING_FRAMES * 2]; // 16-bit scale, full precision (WriteFloat)
+	};
+
+	static FactoryFunction GetFactoryFunction();
+	static RING* GetRing();
+
+	void Reset() override;
+	void Write(int16*, unsigned int, unsigned int) override;
+	void WriteFloat(const float*, unsigned int, unsigned int) override;
+	bool HasFreeBuffers() override;
+	void RecycleBuffers() override;
+};
diff --git a/Source/ui_js/duo_pre.js b/Source/ui_js/duo_pre.js
new file mode 100644
index 0000000..56e00d2
--- /dev/null
+++ b/Source/ui_js/duo_pre.js
@@ -0,0 +1,119 @@
+// Game Duo: runs in the page and in every pthread worker.
+// WKWebView exposes shared memory but not the SharedArrayBuffer global; restore it.
+if (typeof SharedArrayBuffer === 'undefined') {
+  globalThis.SharedArrayBuffer = new WebAssembly.Memory({ initial: 0, maximum: 0, shared: true }).buffer.constructor;
+}
+
+// Disc image access: synchronous range reads from the app's duops2:// handler, on whichever
+// thread asks (the VM thread in practice). 256 KiB blocks, LRU of 64 blocks, sequential read-ahead.
+(function () {
+  const BLOCK = 256 * 1024;
+  const MAX_BLOCKS = 64;
+  const sizes = new Map();
+  const cache = new Map();          // key "path#block" -> Uint8Array (insertion order = LRU)
+  const isWorker = typeof WorkerGlobalScope !== 'undefined';
+  const base = (typeof location !== 'undefined' ? location.origin : '') + '/disc';
+  const url = (path) => base + path.split('/').map(encodeURIComponent).join('/');
+
+  function request(path, start, end) {
+    const xhr = new XMLHttpRequest();
+    xhr.open('GET', url(path), false);
+    xhr.setRequestHeader('Range', `bytes=${start}-${end}`);
+    if (isWorker) {
+      xhr.responseType = 'arraybuffer';
+      xhr.send();
+      if (xhr.status !== 200 && xhr.status !== 206) return null;
+      return new Uint8Array(xhr.response);
+    }
+    xhr.overrideMimeType('text/plain; charset=x-user-defined');
+    xhr.send();
+    if (xhr.status !== 200 && xhr.status !== 206) return null;
+    const text = xhr.responseText;
+    const bytes = new Uint8Array(text.length);
+    for (let i = 0; i < text.length; i++) bytes[i] = text.charCodeAt(i) & 0xff;
+    return bytes;
+  }
+
+  function block(path, index, size) {
+    const key = path + '#' + index;
+    let data = cache.get(key);
+    if (data) { cache.delete(key); cache.set(key, data); return data; }
+    const start = index * BLOCK;
+    // Read two blocks at once when the next one is not cached (sequential streaming).
+    const span = cache.has(path + '#' + (index + 1)) ? 1 : 2;
+    const end = Math.min(size, start + span * BLOCK) - 1;
+    const bytes = request(path, start, end);
+    if (!bytes) return null;
+    for (let i = 0; i * BLOCK < bytes.length; i++) {
+      cache.set(path + '#' + (index + i), bytes.subarray(i * BLOCK, Math.min(bytes.length, (i + 1) * BLOCK)));
+    }
+    while (cache.size > MAX_BLOCKS) cache.delete(cache.keys().next().value);
+    return cache.get(key);
+  }
+
+  Module.duoDiscSize = function (path) {
+    if (sizes.has(path)) return sizes.get(path);
+    const xhr = new XMLHttpRequest();
+    xhr.open('GET', (typeof location !== 'undefined' ? location.origin : '') + '/disc-size' + path.split('/').map(encodeURIComponent).join('/'), false);
+    xhr.send();
+    const size = xhr.status === 200 ? Number(xhr.responseText) : -1;
+    if (size >= 0) sizes.set(path, size);
+    return size;
+  };
+
+  Module.duoDiscRead = function (path, dst, position, length) {
+    const size = Module.duoDiscSize(path);
+    if (size < 0) return -1;
+    const heap = new Uint8Array(wasmMemory.buffer);
+    let done = 0;
+    while (done < length) {
+      const pos = position + done;
+      if (pos >= size) break;
+      const index = Math.floor(pos / BLOCK);
+      const data = block(path, index, size);
+      if (!data) return -1;
+      const offset = pos - index * BLOCK;
+      const count = Math.min(length - done, data.length - offset);
+      if (count <= 0) break;
+      heap.set(data.subarray(offset, offset + count), dst + done);
+      done += count;
+    }
+    return done;
+  };
+})();
+
+// The wasm memory for the audio worklet (it reads the SH_Duo ring buffer directly).
+Module.duoMemory = function () { return wasmMemory; };
+
+// The GS thread renders on an OffscreenCanvas in its own worker (GSH_OpenGLJs). WebKit creates
+// every worker WebGL context through the page's main run loop, and duoInit blocks the main thread
+// until the GS thread is initialised, so each pthread worker creates its canvas and context
+// beforehand (duoWarmWorkers() on the page); the GS thread then reuses its worker's pair.
+if (typeof WorkerGlobalScope !== 'undefined') {
+  self.addEventListener('message', (e) => {
+    if (!e.data || !e.data.duoWarmGL) return;
+    let ok = false;
+    try {
+      self.duoWarmCanvas = new OffscreenCanvas(640, 480);
+      // Same attributes as GSH_OpenGLJs asks for, so its getContext returns this context.
+      self.duoWarmContext = self.duoWarmCanvas.getContext('webgl2', {
+        alpha: false, depth: true, stencil: false, antialias: false, premultipliedAlpha: true,
+        preserveDrawingBuffer: false, powerPreference: 'high-performance',
+      });
+      ok = !!self.duoWarmContext;
+    } catch (err) {}
+    postMessage({ duoWarmed: ok });
+  });
+} else {
+  Module.duoWarmWorkers = function () {
+    return Promise.all(PThread.unusedWorkers.map((worker) => new Promise((resolve) => {
+      const onMessage = (e) => {
+        if (!e.data || e.data.duoWarmed === undefined) return;
+        worker.removeEventListener('message', onMessage);
+        resolve(e.data.duoWarmed);
+      };
+      worker.addEventListener('message', onMessage);
+      worker.postMessage({ duoWarmGL: true });
+    })));
+  };
+}

+
+//Lanczos weights for each fractional position (phase) between two source points, normalised to 1.
+const float* CSpuBase::CInputReconstructor::GetKernel()
+{
+	static std::vector<float> kernel;
+	if(!kernel.empty()) return kernel.data();
+	std::vector<float> table(KERNEL_PHASES * 2 * TAPS_HALF);
+	auto sinc = [](double v) { return (std::abs(v) < 1e-9) ? 1.0 : std::sin(M_PI * v) / (M_PI * v); };
+	for(unsigned int phase = 0; phase < KERNEL_PHASES; phase++)
+	{
+		double x = static_cast<double>(phase) / (KERNEL_PHASES - 1);
+		double total = 0;
+		for(int j = 0; j < 2 * TAPS_HALF; j++)
+		{
+			double d = x - (j - (TAPS_HALF - 1));
+			double w = sinc(d) * sinc(d / TAPS_HALF);
+			table[phase * 2 * TAPS_HALF + j] = static_cast<float>(w);
+			total += w;
+		}
+		for(int j = 0; j < 2 * TAPS_HALF; j++) table[phase * 2 * TAPS_HALF + j] /= static_cast<float>(total);
+	}
+	kernel = std::move(table);
+	return kernel.data();
+}
+
+void CSpuBase::CInputReconstructor::FinishRun(uint64 end)
+{
+	uint32 length = static_cast<uint32>(end - m_runStart);
+	if(length <= MAX_STAT_RUN)
+	{
+		m_runLengths[m_runLengthCount % STAT_RUNS] = length;
+		m_runLengthCount++;
+		UpdateLock();
+	}
+	if(!m_locked)
+	{
+		m_nextTime = static_cast<double>(end);
+		return;
+	}
+	//A long run is several equal source samples in a row.
+	uint32 count = std::max<uint32>(1, static_cast<uint32>(std::lround(length / m_ratio)));
+	for(uint32 j = 0; j < count; j++)
+	{
+		//Sample-and-hold starts a source sample at ceil(its exact time): expect it half a sample early.
+		double observed = static_cast<double>(m_runStart) + (static_cast<double>(length) * j) / count - 0.5;
+		//Second-order loop: the phase follows slowly and the ratio settles on the stream's exact
+		//rate (a ratio re-estimated from recent runs wandered by ~0.1%, audible as pitch wobble).
+		double error = observed - m_nextTime;
+		if(std::abs(error) > 1.5)
+		{
+			m_nextTime = observed;
+		}
+		else
+		{
+			m_nextTime += 0.01 * error;
+			m_ratio += 0.00002 * error;
+		}
+		PushSource(m_nextTime, m_runValue);
+		m_nextTime += m_ratio;
+	}
+}
+
+void CSpuBase::CInputReconstructor::UpdateLock()
+{
+	if(m_runLengthCount < STAT_RUNS)
+	{
+		m_locked = false;
+		return;
+	}
+	//Held streams alternate between two adjacent run lengths (2 and 3 for 22.05 -> 48 kHz);
+	//longer runs are equal source samples in a row and are left out.
+	uint32 histogram[MAX_STAT_RUN + 2] = {};
+	for(uint32 length : m_runLengths) histogram[length]++;
+	uint32 bestLength = 0, bestCount = 0;
+	for(uint32 length = 1; length < MAX_STAT_RUN; length++)
+	{
+		uint32 count = histogram[length] + histogram[length + 1];
+		if(count > bestCount)
+		{
+			bestCount = count;
+			bestLength = length;
+		}
+	}
+	double mean = (bestCount == 0) ? 0 : static_cast<double>(bestLength * histogram[bestLength] + (bestLength + 1) * histogram[bestLength + 1]) / bestCount;
+	bool held = (bestCount * 5 >= STAT_RUNS * 4) && (mean >= 1.5) && (mean <= 8);
+	if(held && !m_locked)
+	{
+		m_srcCount = 0;
+		m_ratio = mean;
+	}
+	m_locked = held;
+}
+
+void CSpuBase::CInputReconstructor::PushSource(double time, const int32 value[2])
+{
+	unsigned int slot = m_srcCount % SRC_POINTS;
+	m_srcTime[slot] = time;
+	m_srcValue[slot][0] = value[0];
+	m_srcValue[slot][1] = value[1];
+	m_srcCount++;
+}

 	if (cpuHz <= 0) {
 		// Paranoid check, protecting against division by zero and similar nonsense.
 		return true;  // encourage logging
 	}
 
+	duoRequestedClockHz = cpuHz;
+	if (duoClockFloorHz > cpuHz) cpuHz = duoClockFloorHz;

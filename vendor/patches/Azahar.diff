 /**
  * libretro callback; Called when a game is to be loaded.
  */
+// DuoDS frontend API. Called on its serial emulation queue with no game running.
+extern "C" __attribute__((visibility("default"))) int duo_install_cia(
+    const char* path, char* installed_path, size_t capacity, uint64_t* title_id) {
+    UpdateSettings();
+    bool compressed = false;
+    auto status = Service::AM::CheckCIAToInstall(path, compressed, true);
+    if (status != Service::AM::InstallStatus::Success) return static_cast<int>(status);
+    std::unique_ptr<FileUtil::IOFileBase> file = std::make_unique<FileUtil::IOFile>(path, "rb");
+    if (compressed) file = std::make_unique<FileUtil::Z3DSReadIOFile>(std::move(file));
+    FileSys::CIAContainer container;
+    if (container.Load(file.get()) != Loader::ResultStatus::Success) return 4;
+    const auto& tmd = container.GetTitleMetadata();
+    *title_id = tmd.GetTitleID();
+    // System titles require the console's system-data setup, never an accidental game import.
+    const auto category = *title_id >> 32;
+    if (category != 0x00040000 && category != 0x0004000e && category != 0x0004008c) return 6;
+    status = Service::AM::InstallCIA(path);
+    if (status != Service::AM::InstallStatus::Success) return static_cast<int>(status);
+    installed_path[0] = 0;
+    if (category == 0x00040000) {
+        size_t boot = 0;
+        for (size_t i = 0; i < tmd.GetContentCount(); ++i)
+            if (tmd.GetContentIDByIndex(i) == tmd.GetBootContentID()) boot = i;
+        const auto result = Service::AM::GetTitleContentPath(Service::AM::GetTitleMediaType(*title_id), *title_id, boot);
+        if (!FileUtil::Exists(result) || result.size() >= capacity) return 4;
+        snprintf(installed_path, capacity, "%s", result.c_str());
+    }
+    return 0;
+}
